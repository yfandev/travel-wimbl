# Crusoe Managed Inference (OpenAI-compatible). Put real keys in .env.local only.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_MODEL=nvidia/Nemotron-3-Super-120B-A12B

# You.com Web Search API: https://you.com/docs/api-reference/search/v1-search
YOU_API_KEY=
YOU_SEARCH_ENDPOINT=https://ydc-index.io/v1/search

WIMBL_DEMO_MODE=true
WIMBL_MAX_SEARCH_RESULTS=6
WIMBL_MAX_AGENT_STEPS=4
WIMBL_MEMORY_PATH=./data/shared_memory.jsonl
